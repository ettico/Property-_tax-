# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared password used to log in to the app (change this!)
APP_PASSWORD="change-me"

# Random secret used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-too"

# AWS S3 bucket used to store uploaded monthly Excel files and survey PDFs.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
