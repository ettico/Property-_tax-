# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign the login session cookie (JWT).
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Used once by `npx prisma db seed` to create the first admin account -
# only takes effect while the users table is still empty. Every user
# after that is added from the /users screen, not from this file.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-too"

# AWS S3 bucket used to store uploaded monthly Excel files and survey PDFs.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""

# Claude API key, used by src/lib/documentExtraction.ts to read scanned
# (often handwritten) survey case-file pages.
ANTHROPIC_API_KEY=""

# Which model tier extractSurveyForm() uses by default. One of the named
# tiers in EXTRACTION_MODELS (accurate | balanced | fast), or a raw model
# ID. Leave unset to use the most accurate (and most expensive) tier -
# these are handwritten forms feeding a financial audit, so a misread
# figure costs more than the extra tokens. Swap to "balanced" or "fast"
# later purely by changing this value, no code change needed.
EXTRACTION_MODEL_ID="accurate"
